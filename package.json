{
  "name": "certifi-gen",
  "private": true,
  "version": "1.0.0",
  "description": "Generador masivo de certificados en PDF que corre 100% en el navegador",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite",
    "predev": "npm run pdfjs-assets",
    "build": "tsc -b && vite build",
    "prebuild": "npm run pdfjs-assets",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0 && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -b",
    "fixtures": "tsx scripts/generate-fixtures.ts",
    "fonts": "tsx scripts/download-fonts.ts",
    "pdfjs-assets": "tsx scripts/copy-pdfjs-assets.ts",
    "pretest": "npm run fixtures",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "pretest:e2e": "npm run fixtures",
    "test:e2e": "playwright test",
    "verify:render": "tsx scripts/render-verification.ts",
    "metrics": "tsx scripts/measure-metrics.ts",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@pdf-lib/upng": "^1.0.1",
    "fflate": "^0.8.3",
    "jszip": "^3.10.2",
    "lucide-react": "^1.57.0",
    "mammoth": "^1.13.0",
    "papaparse": "^5.7.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@napi-rs/canvas": "^1.0.11",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "docx": "^9.11.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
